# The local env for `pnpm dev:server` and `pnpm dev:app` (eng-pipeline#54). Nick's Mac reads it
# from the private secrets repo, `~/.config/sops/envs/phon/local.env`, through
# `scripts/with-env.mjs`. With no secrets repo, copy this file to `.env` at the repo root
# (git-ignored) and fill it in. Run `pnpm env:check` to see that every name arrives.
#
# Keep no env file inside a package: `wrangler dev` reads `apps/server/.dev.vars` and
# `apps/server/.env*`, and Expo reads `apps/app/.env*`, ahead of these values, so the wrapper
# refuses to run while one is there. Never put the deployed Worker's values here.

# The Worker's secrets, which wrangler.jsonc's `secrets.required` names. `wrangler dev` reads them
# from the environment the wrapper builds; a missing one only logs a warning.

# The Planning Center OAuth application (phon#14). For local dev, its redirect URLs are
# http://localhost:8787/auth/callback and http://localhost:8787/connect/callback.
PCO_CLIENT_ID=
PCO_CLIENT_SECRET=

# The HMAC key of the email sign-in address and code hashes. Make one with `openssl rand -hex 32`,
# and never reuse the deployed Worker's key. Without it, every email code request fails.
EMAIL_HASH_KEY=

# The KLIPY app key the GIF search sends (phon#16). A Testing-mode key from KLIPY's Partner Panel.
KLIPY_API_KEY=

# The phone app's one setting, read when Expo bundles it: the Worker's origin. The app derives
# the WebSocket origin from it. `wrangler dev` serves on http://localhost:8787.
EXPO_PUBLIC_PHON_API_URL=http://localhost:8787
